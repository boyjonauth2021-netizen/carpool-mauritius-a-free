# Optional. The static demo runs with every value empty.
# Do not commit a real key. Vite inlines VITE_ variables into the built JavaScript,
# so a browser key must be restricted by HTTP referrer in Google Cloud.

# Maps JavaScript API browser key. Leave blank to keep the Mauritius catalogue
# and the schematic island map.
VITE_GOOGLE_MAPS_API_KEY=

# Not read by this demo. Phone confirmation is a stub and notices stay in the browser.
# A future server would choose its own provider. No account is assumed here.
# SMS_PROVIDER_KEY=
# SMTP_URL=
